{
  "name": "urim",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.0 <23.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.15": "1.1.16",
      "brace-expansion@5.0.6": "5.0.8",
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "api:build": "cd apps/api && python -m build",
    "api:dev": "cd apps/api && python -m uvicorn app.main:app --reload",
    "api:lint": "cd apps/api && python -m ruff check .",
    "api:test": "cd apps/api && python -m pytest",
    "contracts:validate": "pnpm --filter @urim/contracts validate",
    "web:build": "pnpm --filter @urim/web build",
    "web:dev": "pnpm --filter @urim/web dev",
    "web:lint": "pnpm --filter @urim/web lint",
    "web:test": "pnpm --filter @urim/web test",
    "web:typecheck": "pnpm --filter @urim/web typecheck"
  }
}
